[Unit]
Description=NullChat Onion Update Server
After=network-online.target tor.service
Wants=network-online.target

[Service]
Type=simple
User=nullchat-update
Group=nullchat-update
WorkingDirectory=/opt/nullchat-update-server
ExecStart=/usr/bin/python3 /opt/nullchat-update-server/server.py --directory /var/lib/nullchat-updates/public --host 127.0.0.1 --port 8088
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/nullchat-updates/public

[Install]
WantedBy=multi-user.target
