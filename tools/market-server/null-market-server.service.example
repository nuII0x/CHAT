[Unit]
Description=Null0x custodial market and opaque package server
After=network-online.target tor.service
Wants=network-online.target

[Service]
Type=simple
User=nullmarket
Group=nullmarket
WorkingDirectory=/var/lib/null-market
ExecStart=/usr/local/bin/null-market-server --host 127.0.0.1 --port 8899 --data /var/lib/null-market/data
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/null-market

[Install]
WantedBy=multi-user.target
