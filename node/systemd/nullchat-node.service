[Unit]
Description=NullChat Node Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=NULLCHAT_NODE_HOST=0.0.0.0
Environment=NULLCHAT_NODE_PORT=5080
Environment=NULLCHAT_CHAT_PORT=5000
Environment=NULLCHAT_SOCKS_PORT=9050
Environment=NULLCHAT_NODE_CLI=0
Environment=NULLCHAT_NODE_DATA=%h/.local/share/nullchat-node
Environment=NULLCHAT_RELAY_HOSTNAME_FILE=__PROJECT_ROOT__/node/data/hidden_service/hostname
WorkingDirectory=__PROJECT_ROOT__
ExecStart=__PROJECT_ROOT__/node/build/node
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=default.target
